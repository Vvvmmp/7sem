rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validPost(d) {
      return d.keys().hasOnly(['avatarAsset', 'username', 'meta', 'captionPrefix', 'captionMention',
                               'captionSuffix', 'imageAssets', 'ownerId', 'createdAt'])
        && d.username is string && d.username.size() > 0 && d.username.size() <= 30
        && d.captionPrefix is string && d.captionPrefix.size() > 0 && d.captionPrefix.size() <= 500
        && d.imageAssets is list && d.imageAssets.size() > 0 && d.imageAssets.size() <= 5;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'favs'])
        && request.resource.data.role == 'user';
      allow update: if request.auth.uid == uid && changed().hasOnly(['name', 'favs']);
      allow delete: if false;
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validPost(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin())
        && validPost(request.resource.data)
        && !changed().hasAny(['ownerId', 'createdAt']);
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /messages/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.content is string && request.resource.data.content.size() > 0;
    }
  }
}
