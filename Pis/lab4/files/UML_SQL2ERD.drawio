=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="175" y="20" width="665" height="1150" as="geometry"/></mxCell><mxCell id="p2_u22" value="22. Управление рабочим пространством" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="107.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_u23" value="23. Создать workspace" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="43.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u24" value="24. Переименовать workspace" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="107.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u25" value="25. Просмотреть прогресс команды" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="171.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u26" value="26. Управление участниками workspace" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="315.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_u27" value="27. Пригласить разработчика по email" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="251.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u28" value="28. Отозвать приглашение" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="315.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u29" value="29. Исключить участника" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="379.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u30" value="30. Управление проектами" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="523.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_u31" value="31. Создать проект" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="459.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u32" value="32. Изменить или удалить проект" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="523.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u33" value="33. Добавить или исключить разработчика" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="587.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u34" value="34. Управление диаграммами" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="731.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_u35" value="35. Создать диаграмму" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="667.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u36" value="36. Изменить или удалить диаграмму" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="731.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u37" value="37. Назначить уровень доступа" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="795.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p2_u38