<mxfile host="app.diagrams.net"><diagram name="Прецеденты: Гость и Developer" id="uc1"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="1128" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_bnd" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="175" y="20" width="665" height="1078" as="geometry"/></mxCell><mxCell id="p1_u1" value="1. Просмотр проектов и диаграмм" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="43.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u2" value="2. Построение ER-диаграммы по SQL-скрипту" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="123.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u3" value="3. Проверить модель диаграммы" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="123.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u4" value="4. Совместное редактирование ER-диаграммы" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="235.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u5" value="5. Сохранить диаграмму" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="203.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u6" value="6. Экспортировать диаграмму" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="267.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u7" value="7. Комментирование таблиц диаграммы" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="379.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u8" value="8. Ответить в ветке обсуждения" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="347.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u9" value="9. Закрыть или открыть обсуждение" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="411.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u10" value="10. Работа с приглашениями в workspace" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="523.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u11" value="11. Принять приглашение" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="491.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u12" value="12. Отклонить приглашение" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="555.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u13" value="13. Ответ на передачу владения workspace" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="217.5" y="667.0" width="245" height="58" as="geometry"/></mxCell><mxCell id="p1_u14" value="14. Принять передачу" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590.0" y="635.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="p1_u15" value="15. Отклонить передачу" style="ellipse;whiteSpace=wrap;html=1;fontFamily=T