@host = http://localhost:5000/jsonrpc

############################################################
# 1. Процедуры — позиционные параметры (params: [x, y])
############################################################

### SUM(3, 4) -> 7
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": [3, 4], "id": 1 }

### SUB(10, 4.5) -> 5.5
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUB", "params": [10, 4.5], "id": 2 }

### MUL(6, 7) -> 42
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "MUL", "params": [6, 7], "id": 3 }

### DIV(10, 4) -> 2.5
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "DIV", "params": [10, 4], "id": 4 }

### FACT(5) -> 120
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "FACT", "params": [5], "id": 5 }

############################################################
# 2. Процедуры — именованные параметры (params: {"x":..,"y":..})
############################################################

### SUM(x=1.5, y=2.25) -> 3.75
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": { "x": 1.5, "y": 2.25 }, "id": 6 }

### SUB(y=10, x=3) -> -7   (порядок ключей не важен)
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUB", "params": { "y": 10, "x": 3 }, "id": 7 }

### MUL(x=-2, y=2.5) -> -5
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "MUL", "params": { "x": -2, "y": 2.5 }, "id": 8 }

### DIV(x=1, y=3) -> 0.333...
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "DIV", "params": { "x": 1, "y": 3 }, "id": 9 }

### FACT(x=12) -> 479001600  (максимальный факториал, влезающий в int)
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "FACT", "params": { "x": 12 }, "id": 10 }

############################################################
# 3. Ошибки процедур (из задания)
############################################################

### DIV на ноль -> error -32000 "Division by zero"
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "DIV", "params": [5, 0], "id": 11 }

### FACT(13) — больше int.MaxValue -> error -32001 "Result exceeds int range"
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "FACT", "params": { "x": 13 }, "id": 12 }

############################################################
# 4. Ошибки протокола JSON-RPC
############################################################

### Неверный JSON -> -32700 Parse error
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": [1, 2

### Нет поля jsonrpc -> -32600 Invalid Request
POST {{host}}
Content-Type: application/json

{ "method": "SUM", "params": [1, 2], "id": 13 }

### Неизвестный метод -> -32601 Method not found
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "POW", "params": [2, 3], "id": 14 }

### Не хватает параметров -> -32602 Invalid params
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": [1], "id": 15 }

### Лишний именованный параметр -> -32602 Invalid params
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": { "x": 1, "z": 2 }, "id": 16 }

### Параметр не число -> -32602 Invalid params
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": ["1", 2], "id": 17 }

### FACT от дробного числа -> -32602 Invalid params
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "FACT", "params": [2.5], "id": 18 }

### Уведомление (нет id) -> 204 No Content, тела нет
POST {{host}}
Content-Type: application/json

{ "jsonrpc": "2.0", "method": "SUM", "params": [1, 1] }

############################################################
# 5. Пакетная обработка (batch)
############################################################

### Batch: успешные вызовы, ошибки и уведомление в одном запросе
# В ответе 5 элементов: уведомление (SUB без id) не отвечается
POST {{host}}
Content-Type: application/json

[
  { "jsonrpc": "2.0", "method": "SUM",  "params": [1, 2],             "id": 1 },
  { "jsonrpc": "2.0", "method": "MUL",  "params": { "x": 3, "y": 4 }, "id": 2 },
  { "jsonrpc": "2.0", "method": "DIV",  "params": [1, 0],             "id": 3 },
  { "jsonrpc": "2.0", "method": "FACT", "params": { "x": 10 },        "id": 4 },
  { "jsonrpc": "2.0", "method": "SUB",  "params": [9, 9] },
  { "jsonrpc": "2.0", "method": "FACT", "params": [20],               "id": "last" }
]

### Batch с мусорными элементами -> на каждый свой Invalid Request
POST {{host}}
Content-Type: application/json

[
  { "jsonrpc": "2.0", "method": "SUM", "params": [2, 2], "id": 1 },
  1,
  "abc"
]

### Пустой batch -> один ответ -32600 Invalid Request
POST {{host}}
Content-Type: application/json

[]

### Batch только из уведомлений -> 204 No Content
POST {{host}}
Content-Type: application/json

[
  { "jsonrpc": "2.0", "method": "SUM", "params": [1, 2] },
  { "jsonrpc": "2.0", "method": "MUL", "params": [3, 4] }
]
