{
  "ReverseProxy": {
    "Routes": {
      "stack": {
        "ClusterId": "ws01-02",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "ws01-02": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "ws01-02-a": { "Address": "http://ws01-02-a:8080/" },
          "ws01-02-b": { "Address": "http://ws01-02-b:8080/" }
        }
      }
    }
  }
}
