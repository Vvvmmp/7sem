{
  "ReverseProxy": {
    "Routes": {
      "stack": {
        "ClusterId": "ws01-01",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "ws01-01": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": ".WS01.Affinity"
        },
        "Destinations": {
          "ws01-01-a": { "Address": "http://ws01-01-a:8080/" },
          "ws01-01-b": { "Address": "http://ws01-01-b:8080/" }
        }
      }
    }
  }
}
